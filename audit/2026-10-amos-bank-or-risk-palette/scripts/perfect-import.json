[
  {
    "action": "load_snapshot",
    "path": "${RUN}/work-editor.state"
  },
  {
    "action": "press_keys",
    "keys": [
      "ramiga",
      "lshift",
      "m"
    ],
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "type_string",
    "text": "DF0:perfect.asc\n",
    "hold_frames": 3,
    "settle_frames": 30
  },
  {
    "action": "press_key",
    "key": "Return",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 120
  },
  {
    "action": "press_key",
    "key": "f2",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/perfect-syntax.png"
  },
  {
    "action": "press_key",
    "key": "f1",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 300
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/perfect-title.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/perfect-title.state"
  }
]
