[
  {
    "action": "load_snapshot",
    "path": "${RUN}/edited-message-listing.state"
  },
  {
    "action": "load_media",
    "slot": "floppy-0",
    "kind": "disk",
    "path": "${RUN}/amos-work.adf",
    "writable": true
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "press_keys",
    "keys": [
      "ramiga",
      "lshift",
      "s"
    ],
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/message-save-request.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/message-save-request.state"
  }
]
