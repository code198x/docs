[
  {
    "action": "load_snapshot",
    "path": "${RUN}/ask-again-start.state"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/ask-again-held.png"
  },
  {
    "action": "press_key",
    "key": "X",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/ask-again-invalid.png"
  },
  {
    "action": "press_key",
    "key": "Q",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/ask-again-end.png"
  },
  {
    "action": "press_key",
    "key": "Return",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 120
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/ask-again-editor.png"
  }
]
