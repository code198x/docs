[
  {
    "action": "load_snapshot",
    "path": "${RUN}/fresh-choice-start.state"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/fresh-held.png"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/fresh-second.png"
  },
  {
    "action": "press_key",
    "key": "X",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/fresh-invalid.png"
  },
  {
    "action": "press_key",
    "key": "Q",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "press_key",
    "key": "Return",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 120
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/fresh-editor.png"
  }
]
