[
  {
    "action": "load_snapshot",
    "path": "${RUN}/merge-request.state"
  },
  {
    "action": "load_media",
    "slot": "floppy-0",
    "kind": "disk",
    "path": "${RUN}/labels.adf"
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "type_string",
    "text": "DF0:bad.asc\n",
    "settle_frames": 30
  },
  {
    "action": "press_key",
    "key": "Return"
  },
  {
    "action": "run_frames",
    "frames": 120
  },
  {
    "action": "press_key",
    "key": "f1"
  },
  {
    "action": "run_frames",
    "frames": 20
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/label-bad.png"
  }
]
