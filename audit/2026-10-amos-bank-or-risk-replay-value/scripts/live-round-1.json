[
  {
    "action": "load_snapshot",
    "path": "${RUN}/live-active.state"
  },
  {
    "action": "start_audio_recording",
    "path": "${RUN}/live-round-1.wav"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/live-roll-1.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/live-roll-1.state"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/live-result-1.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/live-result-1.state"
  },
  {
    "action": "run_frames",
    "frames": 90
  },
  {
    "action": "stop_audio_recording"
  }
]
