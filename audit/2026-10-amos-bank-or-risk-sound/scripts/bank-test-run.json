[
  {
    "action": "load_snapshot",
    "path": "${RUN}/bank-test-listing.state"
  },
  {
    "action": "load_media",
    "slot": "floppy-0",
    "kind": "disk",
    "path": "${RUN}/amos-work.adf",
    "writable": true
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "press_key",
    "key": "f2",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/bank-test-syntax.png"
  },
  {
    "action": "start_audio_recording",
    "path": "${RUN}/bank-test-startup.wav"
  },
  {
    "action": "press_key",
    "key": "f1",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 300
  },
  {
    "action": "stop_audio_recording"
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/bank-test-title.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/bank-test-title.state"
  }
]
