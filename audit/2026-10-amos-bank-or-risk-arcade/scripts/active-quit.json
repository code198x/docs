[
  {
    "action": "load_snapshot",
    "path": "${RUN}/live-active.state"
  },
  {
    "action": "press_key",
    "key": "Q",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/active-editor.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/active-editor.state"
  }
]
