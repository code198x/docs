[
  {
    "action": "load_snapshot",
    "path": "${RUN}/colour-five-start.state"
  },
  {
    "action": "press_key",
    "key": "Space",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/colour-active.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/colour-active.state"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/colour-roll.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/colour-roll.state"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/colour-result.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/colour-result.state"
  }
]
