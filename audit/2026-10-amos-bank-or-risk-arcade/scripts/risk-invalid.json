[
  {
    "action": "load_snapshot",
    "path": "${RUN}/risk-pending.state"
  },
  {
    "action": "start_audio_recording",
    "path": "${RUN}/pending-invalid.wav"
  },
  {
    "action": "press_key",
    "key": "X",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "press_key",
    "key": "Space",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/risk-pending-stable.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/risk-pending-stable.state"
  },
  {
    "action": "stop_audio_recording"
  }
]
