[
  {
    "action": "load_snapshot",
    "path": "${RUN}/risk-pending.state"
  },
  {
    "action": "start_audio_recording",
    "path": "${RUN}/accept.wav"
  },
  {
    "action": "press_key",
    "key": "B",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 40
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/risk-accepted.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/risk-accepted.state"
  },
  {
    "action": "run_frames",
    "frames": 90
  },
  {
    "action": "stop_audio_recording"
  }
]
