[
  {
    "action": "load_snapshot",
    "path": "${RUN}/work-editor.state"
  },
  {
    "action": "press_keys",
    "keys": [
      "ramiga",
      "lshift",
      "m"
    ],
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "load_media",
    "slot": "floppy-0",
    "kind": "disk",
    "path": "${RUN}/arcade.adf"
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "type_string",
    "text": "DF0:arcade-layout.asc\n",
    "hold_frames": 3,
    "settle_frames": 30
  },
  {
    "action": "press_key",
    "key": "Return",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 360
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/arcade-layout-imported.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/arcade-layout-listing.state"
  }
]
