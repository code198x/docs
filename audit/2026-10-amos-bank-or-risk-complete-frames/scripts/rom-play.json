[
  {
    "action": "load_snapshot",
    "path": "${RUN}/rom-text-start.state"
  },
  {
    "action": "press_key",
    "key": "Space",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 90
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/rom-active.png"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 90
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/rom-roll.png"
  },
  {
    "action": "press_key",
    "key": "B",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 90
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/rom-bank.png"
  },
  {
    "action": "press_key",
    "key": "Q",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 45
