[
  {
    "action": "load_snapshot",
    "path": "${RUN}/finish-reopened-listing.state"
  },
  {
    "action": "press_key",
    "key": "f2",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 180
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/finish-reopened-syntax.png"
  },
  {
    "action": "press_key",
    "key": "f1",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 300
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/finish-reopened-title.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/finish-reopened-title.state"
  }
]
