[
  {
    "action": "load_snapshot",
    "path": "${RUN}/loss-result-3.state"
  },
  {
    "action": "start_audio_recording",
    "path": "${RUN}/loss-replay.wav"
  },
  {
    "action": "press_key",
    "key": "A",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/loss-reset.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/loss-reset.state"
  },
  {
    "action": "run_frames",
    "frames": 90
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/loss-reset-wait.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/loss-reset-wait.state"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/loss-fresh.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/loss-fresh.state"
  },
  {
    "action": "press_key",
    "key": "B",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/loss-new-bank.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/loss-new-bank.state"
  },
  {
    "action": "press_key",
    "key": "Q",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/loss-editor.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/loss-editor.state"
  },
  {
    "action": "stop_audio_recording"
  }
]
