[
  {
    "action": "load_snapshot",
    "path": "${RUN}/possible-six-listing.state"
  },
  {
    "action": "load_media",
    "slot": "floppy-0",
    "kind": "disk",
    "path": "${RUN}/amos-work.adf",
    "writable": true
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "press_key",
    "key": "f2",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 60
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/possible-six-syntax.png"
  },
  {
    "action": "press_key",
    "key": "f1",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 90
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/possible-six-start.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/possible-six-start.state"
  }
]
