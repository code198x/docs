  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/random-bank.png"
  },
  {
    "action": "save_snapshot",
    "path": "${RUN}/random-bank.state"
  },
  {
    "action": "press_key",
    "key": "Space",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
