[
  {
    "action": "load_snapshot",
    "path": "${RUN}/session-reopened-title.state"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/reopened-roll.png"
  },
  {
    "action": "press_key",
    "key": "B",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/reopened-bank.png"
  },
  {
    "action": "press_key",
    "key": "Space",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/reopened-next.png"
  },
  {
    "action": "press_key",
    "key": "Q",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "press_key",
    "key": "Return",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 120
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/reopened-editor.png"
  }
]
