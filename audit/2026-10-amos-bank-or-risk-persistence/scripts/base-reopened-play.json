[
  {
    "action": "load_snapshot",
    "path": "${RUN}/base-reopened-title.state"
  },
  {
    "action": "start_audio_recording",
    "path": "${RUN}/base-reopened-bank.wav"
  },
  {
    "action": "press_key",
    "key": "Space",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/base-reopened-round.png"
  },
  {
    "action": "press_key",
    "key": "R",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/base-reopened-roll.png"
  },
  {
    "action": "press_key",
    "key": "B",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/base-reopened-bank.png"
  },
  {
    "action": "press_key",
    "key": "Q",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/base-reopened-quit.png"
  },
  {
    "action": "press_key",
    "key": "Return",
    "hold_frames": 3
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "save_screenshot",
    "path": "${RUN}/base-reopened-editor.png"
  },
  {
    "action": "stop_audio_recording"
  }
]
