[
  {
    "action": "load_snapshot",
    "path": "${RUN}/perfect-reopened-final.state"
  },
  {
    "action": "run_frames",
    "frames": 30
  },
  {
    "action": "press_key",
    "key": "A",
    "hold_frames": 90
  },
  {
    "action": "run_frames",
    "frames": 12
  },
  {
